---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Stage from '../components/Stage.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  footer={false}
  description="Marios Konomis reconstructs ancient objects and places — from the Derveni Krater to the Stoa of Philip V — with real-time engines and physical output. Athens, Greece."
>
  <Stage projects={projects} frames={40} />
</Base>
