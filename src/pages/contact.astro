---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---

<Base title="Contact" description={`Contact ${site.name}, 3D artist in ${site.location}. Available for freelance and full-time work.`}>
  <div class="wrap">
    <header class="page-head" style="text-align:center">
      <p class="carve rv in">Commissions · Collaborations · Studios</p>
      <h1 class="display rv in" style="--d:.08s">Say hello</h1>
    </header>

    <div class="page-body" style="max-width:none;text-align:center">
      <p class="rv in" style="--d:.14s">{site.availability} The quickest way to reach me is email.</p>
      <p class="rv in" style="--d:.2s">
        <a class="cta-mail" href={`mailto:${site.email}`}>{site.email}</a>
      </p>

      <h2 class="rv" style="margin-top:3.5rem">Elsewhere</h2>
      <p class="rv">
        {site.links.map((l, i) => (
          <>
            {i > 0 && <> &nbsp;·&nbsp; </>}
            <a class="cta-mail" style="font-size:1rem" href={l.href} rel="noopener">{l.label} ↗</a>
          </>
        ))}
      </p>

      <p class="rv" style="margin-top:3rem"><span class="avail"><i></i>{site.availability}</span></p>
    </div>
  </div>
</Base>
